# ChartNav buyer-demo .env.example — PLACEHOLDERS ONLY.
# Copy to .env locally if you need to override a default. DO NOT
# commit a .env with real values. DO NOT include real vendor keys.

# ----- Buyer-demo gates --------------------------------------------------
# CHARTNAV_ENV is one of: local / dev / demo / test.
# NEVER set this to production / staging / controlled-pilot here.
CHARTNAV_ENV=local

# Default deterministic provider. The wrapper refuses to set LLM_ENABLED=1
# in any buyer-demo context.
CHARTNAV_LLM_PROVIDER=deterministic_stub

# Real-PHI gate is OFF for the buyer demo. Never flip these to 1.
CHARTNAV_LLM_REAL_PHI_APPROVED=0
CHARTNAV_REAL_PHI_ENABLED=0

# Pilot-allow flags must stay 0/unset — flipping them to 1 would
# semantically claim approval ChartNav does not have. Phase 52B
# semantic flip — see docs/security/chartnav-openai-fake-data-adapter.md.
CHARTNAV_PILOT_ALLOW_LLM_OPENAI=0
CHARTNAV_PILOT_ALLOW_LLM_ANTHROPIC=0

# Optional feature opt-ins. UNSET BY DEFAULT. Set to "openai" only
# for an explicit fake-data assist demo with the full Phase 52B
# SAFE-state gates documented in docs/security/chartnav-openai-fake-data-adapter.md.
# CHARTNAV_FUNDUS_DRAFTING_ASSIST=openai
# CHARTNAV_AMBIENT_DOCUMENTATION_ASSIST=openai

# ----- Vendor credentials -------------------------------------------------
# Do NOT paste real keys here. If you need to run the OpenAI fake-data
# assist locally, source a separate (gitignored) config.env outside
# this folder and never echo the value on camera.
# CHARTNAV_OPENAI_API_KEY=
# CHARTNAV_OPENAI_LLM_MODEL=gpt-4o-mini
# CHARTNAV_ANTHROPIC_API_KEY=
# CHARTNAV_ANTHROPIC_MODEL=claude-haiku-4-5

# ----- Auth + database ----------------------------------------------------
# Header-mode auth is the local dev default; do NOT switch to header mode
# in production. The runtime safety validator blocks header auth on
# CHARTNAV_ENV=production.
CHARTNAV_AUTH_MODE=header

# Local SQLite database (the Makefile points at this by default).
# DATABASE_URL=sqlite:///./chartnav.db
