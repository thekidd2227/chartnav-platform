# ChartNav API — runtime configuration contract.
# Full reference: docs/build/12-runtime-config.md

# ---- Environment name (informational) ----
# dev | test | ci | prod
CHARTNAV_ENV=dev

# ---- Database ----
# Required. SQLAlchemy URL.
DATABASE_URL=sqlite:///./chartnav.db
# Postgres example:
# DATABASE_URL=postgresql+psycopg://chartnav:chartnav@localhost:5432/chartnav

# ---- Auth transport ----
# header  → dev only. Reads X-User-Email (trivially spoofable).
# bearer  → production. Validates `Authorization: Bearer <jwt>`
#           against CHARTNAV_JWT_JWKS_URL (signature + iss + aud + exp).
#           Mapping from token to users row is by claim
#           CHARTNAV_JWT_USER_CLAIM (default "email").
CHARTNAV_AUTH_MODE=header

# Required when CHARTNAV_AUTH_MODE=bearer (app refuses to import otherwise):
# CHARTNAV_JWT_ISSUER=https://auth.example.com/
# CHARTNAV_JWT_AUDIENCE=chartnav-api
# CHARTNAV_JWT_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# CHARTNAV_JWT_USER_CLAIM=email

# ---- CORS ----
# Comma-separated origins. Empty string → same-origin only.
# The default covers local Vite dev on both :5173 (developer) and :5174 (E2E).
CHARTNAV_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ---- Rate limiting (per process, in-memory) ----
# Requests per 60s window per (client_ip, path). 0 disables.
CHARTNAV_RATE_LIMIT_PER_MINUTE=120

# ---- Entrypoint ----
# If 1, container entrypoint runs scripts_seed.py after migrations.
# Keep 0 in production.
CHARTNAV_RUN_SEED=0

# ---- Uvicorn ----
API_HOST=0.0.0.0
API_PORT=8000
# Worker processes in the container (entrypoint.sh serve). Tune per task size.
WEB_CONCURRENCY=2

# ============================================================================
# PRODUCTION (CHARTNAV_ENV=prod). The app refuses to start in prod with header
# auth, SQLite, or wildcard CORS. The production-readiness gate
# (scripts/production/production_readiness_check.py) checks the rest.
# Real secret VALUES come from AWS Secrets Manager — never commit them.
# ============================================================================
# CHARTNAV_ENV=prod
# CHARTNAV_AUTH_MODE=bearer            # + the CHARTNAV_JWT_* vars above
# DATABASE_URL=postgresql+psycopg://USER:PASS@HOST:5432/chartnav?sslmode=require
# CHARTNAV_CORS_ALLOW_ORIGINS=https://app.chartnavmd.com

# ---- Public hostnames (required in prod; must be https) ----
# CHARTNAV_APP_URL=https://app.chartnavmd.com
# CHARTNAV_API_URL=https://api.chartnavmd.com

# ---- App secrets (>=16 chars; from Secrets Manager in prod) ----
# CHARTNAV_SECRET_KEY=__from_secrets_manager__
# CHARTNAV_SESSION_SECRET=__from_secrets_manager__

# ---- Object storage (apps/api/app/storage) ----
# local → dev filesystem (refused in prod). s3 → production.
CHARTNAV_STORAGE_BACKEND=local
# CHARTNAV_STORAGE_LOCAL_ROOT=./object_store     # local backend only
# CHARTNAV_S3_BUCKET=chartnav-production-objects  # s3 backend
# CHARTNAV_S3_KMS_KEY_ID=arn:aws:kms:REGION:ACCT:key/KEY-ID  # required for s3
# AWS_REGION=us-east-1

# ---- Audit log retention (days). Production expected multi-year. ----
CHARTNAV_AUDIT_RETENTION_DAYS=0
# CHARTNAV_AUDIT_RETENTION_DAYS=2555   # ~7 years in production

# ---- Operational flags (must be off/false in prod) ----
# CHARTNAV_DEBUG=false
# CHARTNAV_SEED_DEMO=false
# Set by IaC once RDS automated backups + AWS Backup are provisioned:
# CHARTNAV_BACKUPS_CONFIGURED=true
