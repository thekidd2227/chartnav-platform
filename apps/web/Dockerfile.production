# Production multi-stage build for the ChartNav React app.
# (The plain Dockerfile is dev-only — `npm run dev`. This one is for
# production-like serving / building the deployable static artifact.)
#
#   stage 1 (build) — produce the static Vite artifact.
#   stage 2 (serve) — nginx serving the static files. In real production the
#                     built artifact is uploaded to S3 + served by CloudFront;
#                     this image backs the production-like compose.
#
# Only explicitly-allowed, NON-SECRET VITE_* build args are embedded.

FROM node:20-alpine AS build
WORKDIR /app

ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}

COPY package.json package-lock.json* ./
RUN npm ci || npm install
COPY . .
RUN npm run build

# Export-only target: `docker build --target artifact -o type=local,dest=out`
FROM scratch AS artifact
COPY --from=build /app/dist /

FROM nginx:1.27-alpine AS serve
RUN printf '%s\n' \
  'server {' \
  '  listen 8080;' \
  '  root /usr/share/nginx/html;' \
  '  location / { try_files $uri $uri/ /index.html; }' \
  '  location = /healthz { return 200 "ok"; add_header Content-Type text/plain; }' \
  '}' > /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
RUN chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/log/nginx \
  && touch /var/run/nginx.pid && chown nginx:nginx /var/run/nginx.pid
USER nginx
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://localhost:8080/healthz || exit 1
CMD ["nginx", "-g", "daemon off;"]
