# Safe EXAMPLE production env for dry-running the readiness gate.
# Contains NO real secrets — placeholder-but-well-formed values only.
# Do NOT use these values for a real deployment. Real secrets come from
# AWS Secrets Manager (see infra/terraform/aws/secrets.tf).
CHARTNAV_ENV=prod
CHARTNAV_AUTH_MODE=bearer
CHARTNAV_JWT_ISSUER=https://idp.example.com/
CHARTNAV_JWT_AUDIENCE=chartnav-api
CHARTNAV_JWT_JWKS_URL=https://idp.example.com/.well-known/jwks.json
DATABASE_URL=postgresql+psycopg://chartnav:EXAMPLE_ONLY_NOT_A_REAL_SECRET@db.internal:5432/chartnav?sslmode=require
CHARTNAV_SECRET_KEY=example-only-32-char-min-rotate-me-please
CHARTNAV_SESSION_SECRET=example-only-32-char-min-rotate-me-please
CHARTNAV_DEBUG=false
CHARTNAV_SEED_DEMO=false
CHARTNAV_CORS_ALLOW_ORIGINS=https://app.chartnavmd.com
CHARTNAV_APP_URL=https://app.chartnavmd.com
CHARTNAV_API_URL=https://api.chartnavmd.com
CHARTNAV_STORAGE_BACKEND=s3
CHARTNAV_S3_BUCKET=chartnav-prod-objects-EXAMPLE
CHARTNAV_S3_KMS_KEY_ID=arn:aws:kms:us-east-1:000000000000:key/EXAMPLE-0000-0000-0000-000000000000
CHARTNAV_BACKUPS_CONFIGURED=true
CHARTNAV_AUDIT_RETENTION_DAYS=2555
