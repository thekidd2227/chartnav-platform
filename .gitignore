apps/api/audio_uploads/
audio_uploads/

# Phase 17 — generated desktop demo delivery package. The Desktop
# folder is regenerated by scripts/export_chartnav_decks_to_desktop.sh
# from the repo source; it must never be committed back in.
chartnav decks/
desktop-export/
**/Desktop/chartnav decks/

# Phase 62 / 62A — buyer-demo screenshots + video clips are captured
# locally by the operator. The shot lists in docs/demo/ define what
# to capture; the actual PNG / MOV / MP4 files are not committed.
# Phase 62A: the dated dry-run report.md scaffold IS committed (it's
# part of the demo claims scanner FILES list); only capture binaries
# inside dry-runs/ are ignored.
# Phase 88 — release-evidence + live-site snapshot artifact directories
# are operator-run output, not committed. The scripts that produce them
# live under scripts/release/.
artifacts/release-evidence/
artifacts/live-site-snapshots/
artifacts/phase-93-pilot-launch/
artifacts/phase-100-controlled-pilot-launch/
artifacts/buyer-demo/

artifacts/phase-62/screenshots/*.png
artifacts/phase-62/screenshots/*.jpg
artifacts/phase-62/video-clips/*.mov
artifacts/phase-62/video-clips/*.mp4
artifacts/phase-62/video-clips/*.webm
artifacts/phase-62/video-clips/*.gif
artifacts/phase-62/dry-runs/**/*.png
artifacts/phase-62/dry-runs/**/*.jpg
artifacts/phase-62/dry-runs/**/*.mov
artifacts/phase-62/dry-runs/**/*.mp4
artifacts/phase-62/dry-runs/**/*.webm
artifacts/phase-62/dry-runs/**/*.gif

